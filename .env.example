WORDPRESS_URL="https://wordpress.com"
WORDPRESS_HOSTNAME="wordpress.com"
# Set true while editing a local CMS to fetch current content on every refresh.
# The bypass applies to local development/tests only; production always caches.
# Configure the revalidation webhook to refresh published content after edits.
WORDPRESS_CACHE_DISABLED="false"

# Public canonical domain. Use localhost for an unindexed local preview.
NEXT_PUBLIC_SITE_URL="https://luzikkielce.pl"
# Set false for non-public staging deployments. Public production enables indexing.
SITE_INDEXABLE="true"
# Real Luzik posts can be indexed on production. Staging is always noindex.
# Set false if a deployment still contains demo or incomplete articles.
BLOG_INDEXABLE="true"

# If using the revalidate plugin
# You can generate by running `openssl rand -base64 32` in the terminal
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"

# Server-only key, restricted to Places API (New). Never use NEXT_PUBLIC_ here.
# Without it, reviews come from WordPress via the Luzik reviews bridge + Trustindex.
# If neither source is ready, the section links to Google instead of showing sample reviews.
GOOGLE_PLACES_API_KEY=""

# Server-only key from WordPress: Ustawienia -> Oceny instruktorów.
WORDPRESS_RATINGS_SECRET=""
