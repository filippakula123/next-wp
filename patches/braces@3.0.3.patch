--- /dev/null
+++ b/lib/depth-limit.js
@@ -0,0 +1,8 @@
+'use strict';
+
+// CVE-2026-93687: bound recursive AST traversal, including caller-supplied ASTs.
+module.exports = depth => {
+  if (depth > 128) {
+    throw new SyntaxError('Brace nesting exceeds the safety limit of 128');
+  }
+};
